{
    "name": "omnisign/docusign",
    "type": "library",
    "description": "Omnisign DocuSign: envelopes through DocuSign's eSignature REST API v2.1 - JWT grant with the application's RSA key, documents, signers in order, signature tabs, embedded signing (recipient views), reminders, voiding, the combined signed document and the certificate of completion, Connect webhooks with their HMAC checked.",
    "keywords": [
        "signature",
        "e-signature",
        "docusign",
        "omnisign"
    ],
    "homepage": "https://github.com/glitchr-studio/omnisign-docusign",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "ext-openssl": "*",
        "glitchr/omnisign": "^1.0@dev",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnisign\\Docusign\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnisign\\Docusign\\Tests\\": "Tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
